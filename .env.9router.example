HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:20128/v1
HINDSIGHT_API_LLM_API_KEY=replace-with-your-9router-api-key
HINDSIGHT_API_LLM_MODEL=1
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
HINDSIGHT_API_EMBEDDINGS_ONNX_DIMENSIONS=384
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# Keep the API private to this Mac. Change this only when remote access is intentional.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_WORKER_ID=hindsight-local

# Hindsight's official production path uses external PostgreSQL 14+ with a
# supported vector extension. This setup uses Homebrew PostgreSQL 17 + pgvector
# on loopback port 5433. Replace the password before starting the API.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:replace-with-database-password@127.0.0.1:5433/hindsight

# Keep a production audit trail. Memory Defense remains a per-bank setting and
# is enabled through the Control Plane or bank configuration API.
HINDSIGHT_API_AUDIT_LOG_ENABLED=true
HINDSIGHT_API_AUDIT_LOG_RETENTION_DAYS=30
